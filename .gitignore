node_modules/
# The verdict cache. Commit it if you want CI to lint without an API key and
# reviewers to see the same verdicts you did; leave it ignored if you would
# rather pay the warm pass on every CI run. Whichever you pick, treat it as
# trusted input -- anything that can edit it can silence a rule.
.jev-lint-cache.json
*.tmp
.jev-lint-self.json
dist/
*.tgz
# The last eval run, accepted or not; the accepted one is baseline.json.
rules/*/*/last.json
experiments/rule-candidates/*/*/last.json
