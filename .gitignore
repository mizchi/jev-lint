node_modules/
# The verdict cache. jev-lint's default is to commit it, so CI lints without
# an API key and reviewers see the verdicts you did; this repository changes
# its source on most commits and would carry a megabyte of churn each time,
# so it pays the warm pass instead. Whichever you pick, treat it as trusted
# input -- anything that can edit it can silence a rule.
.jev-lint/baseline.json

# Built tree-sitter parsers: a megabyte each, and platform-specific.
# `npm run parsers:moonbit` writes one; docs/moonbit.jev-lint.yaml names it.
.jev-lint/parsers/
*.tmp
.jev-lint-self.json
dist/
*.tgz
# The last eval run, accepted or not; the accepted one is baseline.json.
rules/*/*/last.json
experiments/rule-candidates/*/*/last.json
